<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_07" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.15.0">
  <bpmn:collaboration id="Collab_07">
    <bpmn:participant id="Part_Conflictos" name="Detección y Resolución de Conflictos de Horario" processRef="Proc_Conflictos" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Conflictos" name="Resolución de Conflictos" isExecutable="true">
    <bpmn:laneSet id="LaneSet_07">
      <bpmn:lane id="Lane_Coord_07" name="Coordinador Académico">
        <bpmn:flowNodeRef>Task_RevisarSugerencias</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AplicarSwap</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Engine_07" name="Motor de Reglas / Scheduling Engine">
        <bpmn:flowNodeRef>Start_07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluarColisiones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_HayCruces</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_07_NoConflicto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalcularSugerencias</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_07_Resuelto</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_07" name="Verificación Solicitada"><bpmn:outgoing>F_07_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_EvaluarColisiones" name="Evaluar Matriz de Solapamiento (Ambiente × Instructor × Ficha)"><bpmn:incoming>F_07_1</bpmn:incoming><bpmn:outgoing>F_07_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_HayCruces" name="¿Se Detectaron Colisiones?"><bpmn:incoming>F_07_2</bpmn:incoming><bpmn:outgoing>F_07_No</bpmn:outgoing><bpmn:outgoing>F_07_Si</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_07_NoConflicto" name="Sin Conflictos (Aprobado)"><bpmn:incoming>F_07_No</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_CalcularSugerencias" name="Clasificar Conflictos y Buscar Franjas/Recursos Alternativos Libres"><bpmn:incoming>F_07_Si</bpmn:incoming><bpmn:outgoing>F_07_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_RevisarSugerencias" name="Revisar Panel de Conflictos y Opciones"><bpmn:incoming>F_07_3</bpmn:incoming><bpmn:outgoing>F_07_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_AplicarSwap" name="Aplicar Reasignación o Intercambio (Swap)"><bpmn:incoming>F_07_4</bpmn:incoming><bpmn:outgoing>F_07_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End_07_Resuelto" name="Conflicto Resuelto"><bpmn:incoming>F_07_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_07_1" sourceRef="Start_07" targetRef="Task_EvaluarColisiones" />
    <bpmn:sequenceFlow id="F_07_2" sourceRef="Task_EvaluarColisiones" targetRef="Gate_HayCruces" />
    <bpmn:sequenceFlow id="F_07_No" name="No" sourceRef="Gate_HayCruces" targetRef="End_07_NoConflicto" />
    <bpmn:sequenceFlow id="F_07_Si" name="Sí" sourceRef="Gate_HayCruces" targetRef="Task_CalcularSugerencias" />
    <bpmn:sequenceFlow id="F_07_3" sourceRef="Task_CalcularSugerencias" targetRef="Task_RevisarSugerencias" />
    <bpmn:sequenceFlow id="F_07_4" sourceRef="Task_RevisarSugerencias" targetRef="Task_AplicarSwap" />
    <bpmn:sequenceFlow id="F_07_5" sourceRef="Task_AplicarSwap" targetRef="End_07_Resuelto" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_07"><bpmndi:BPMNPlane id="Plane_07" bpmnElement="Collab_07">
    <bpmndi:BPMNShape id="Part_Conflictos_di" bpmnElement="Part_Conflictos" isHorizontal="true"><dc:Bounds x="160" y="80" width="1050" height="420" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Coord_07_di" bpmnElement="Lane_Coord_07" isHorizontal="true"><dc:Bounds x="190" y="80" width="1020" height="210" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Engine_07_di" bpmnElement="Lane_Engine_07" isHorizontal="true"><dc:Bounds x="190" y="290" width="1020" height="210" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_07_di" bpmnElement="Start_07"><dc:Bounds x="232" y="372" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_EvaluarColisiones_di" bpmnElement="Task_EvaluarColisiones"><dc:Bounds x="310" y="350" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Gate_HayCruces_di" bpmnElement="Gate_HayCruces" isMarkerVisible="true"><dc:Bounds x="485" y="365" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_07_NoConflicto_di" bpmnElement="End_07_NoConflicto"><dc:Bounds x="492" y="442" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_CalcularSugerencias_di" bpmnElement="Task_CalcularSugerencias"><dc:Bounds x="580" y="350" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_RevisarSugerencias_di" bpmnElement="Task_RevisarSugerencias"><dc:Bounds x="730" y="140" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_AplicarSwap_di" bpmnElement="Task_AplicarSwap"><dc:Bounds x="890" y="140" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_07_Resuelto_di" bpmnElement="End_07_Resuelto"><dc:Bounds x="1072" y="372" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F_07_1_di" bpmnElement="F_07_1"><di:waypoint x="268" y="390" /><di:waypoint x="310" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_07_2_di" bpmnElement="F_07_2"><di:waypoint x="440" y="390" /><di:waypoint x="485" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_07_No_di" bpmnElement="F_07_No"><di:waypoint x="510" y="415" /><di:waypoint x="510" y="442" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_07_Si_di" bpmnElement="F_07_Si"><di:waypoint x="535" y="390" /><di:waypoint x="580" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_07_3_di" bpmnElement="F_07_3"><di:waypoint x="710" y="390" /><di:waypoint x="795" y="390" /><di:waypoint x="795" y="220" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_07_4_di" bpmnElement="F_07_4"><di:waypoint x="860" y="180" /><di:waypoint x="890" y="180" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_07_5_di" bpmnElement="F_07_5"><di:waypoint x="1020" y="180" /><di:waypoint x="1090" y="180" /><di:waypoint x="1090" y="372" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>