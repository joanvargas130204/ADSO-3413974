<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_05" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.15.0">
  <bpmn:collaboration id="Collab_05">
    <bpmn:participant id="Part_Auth" name="Autenticación, Verificación RBAC y Gestión de Sesión" processRef="Proc_Auth" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Auth" name="Autenticación y Sesión" isExecutable="true">
    <bpmn:laneSet id="LaneSet_05">
      <bpmn:lane id="Lane_User_05" name="Usuario (Coordinador / Instructor / Aprendiz / Director / Soporte)">
        <bpmn:flowNodeRef>Start_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Credenciales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dashboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_05_Ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sys_05" name="Servicio de Autenticación &amp; Gateway (IAM)">
        <bpmn:flowNodeRef>Task_ValidarHash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Creds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegFallo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_05_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObtenerRoles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmitirJWT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_05" name="Ingreso a la Plataforma"><bpmn:outgoing>F_05_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_Credenciales" name="Ingresar Correo Institucional y Contraseña"><bpmn:incoming>F_05_1</bpmn:incoming><bpmn:outgoing>F_05_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidarHash" name="Verificar Hash de Credenciales y Estado de Cuenta"><bpmn:incoming>F_05_2</bpmn:incoming><bpmn:outgoing>F_05_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_Creds" name="¿Credenciales Válidas?"><bpmn:incoming>F_05_3</bpmn:incoming><bpmn:outgoing>F_05_No</bpmn:outgoing><bpmn:outgoing>F_05_Si</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RegFallo" name="Registrar Intento Fallido e Incrementar Contador"><bpmn:incoming>F_05_No</bpmn:incoming><bpmn:outgoing>F_05_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="End_05_Fail" name="Acceso Denegado (401)"><bpmn:incoming>F_05_4</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_ObtenerRoles" name="Consultar Roles y Permisos RBAC"><bpmn:incoming>F_05_Si</bpmn:incoming><bpmn:outgoing>F_05_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_EmitirJWT" name="Generar Access Token (JWT) y Refresh Token"><bpmn:incoming>F_05_5</bpmn:incoming><bpmn:outgoing>F_05_6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_Dashboard" name="Cargar App Shell y Dashboard según Rol"><bpmn:incoming>F_05_6</bpmn:incoming><bpmn:outgoing>F_05_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End_05_Ok" name="Sesión Activa"><bpmn:incoming>F_05_7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_05_1" sourceRef="Start_05" targetRef="Task_Credenciales" />
    <bpmn:sequenceFlow id="F_05_2" sourceRef="Task_Credenciales" targetRef="Task_ValidarHash" />
    <bpmn:sequenceFlow id="F_05_3" sourceRef="Task_ValidarHash" targetRef="Gate_Creds" />
    <bpmn:sequenceFlow id="F_05_No" name="No" sourceRef="Gate_Creds" targetRef="Task_RegFallo" />
    <bpmn:sequenceFlow id="F_05_Si" name="Sí" sourceRef="Gate_Creds" targetRef="Task_ObtenerRoles" />
    <bpmn:sequenceFlow id="F_05_4" sourceRef="Task_RegFallo" targetRef="End_05_Fail" />
    <bpmn:sequenceFlow id="F_05_5" sourceRef="Task_ObtenerRoles" targetRef="Task_EmitirJWT" />
    <bpmn:sequenceFlow id="F_05_6" sourceRef="Task_EmitirJWT" targetRef="Task_Dashboard" />
    <bpmn:sequenceFlow id="F_05_7" sourceRef="Task_Dashboard" targetRef="End_05_Ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_05"><bpmndi:BPMNPlane id="Plane_05" bpmnElement="Collab_05">
    <bpmndi:BPMNShape id="Part_Auth_di" bpmnElement="Part_Auth" isHorizontal="true"><dc:Bounds x="160" y="80" width="1050" height="420" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_User_05_di" bpmnElement="Lane_User_05" isHorizontal="true"><dc:Bounds x="190" y="80" width="1020" height="210" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Sys_05_di" bpmnElement="Lane_Sys_05" isHorizontal="true"><dc:Bounds x="190" y="290" width="1020" height="210" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_05_di" bpmnElement="Start_05"><dc:Bounds x="232" y="162" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Credenciales_di" bpmnElement="Task_Credenciales"><dc:Bounds x="310" y="140" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ValidarHash_di" bpmnElement="Task_ValidarHash"><dc:Bounds x="310" y="350" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Gate_Creds_di" bpmnElement="Gate_Creds" isMarkerVisible="true"><dc:Bounds x="485" y="365" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_RegFallo_di" bpmnElement="Task_RegFallo"><dc:Bounds x="580" y="410" width="110" height="70" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_05_Fail_di" bpmnElement="End_05_Fail"><dc:Bounds x="732" y="427" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ObtenerRoles_di" bpmnElement="Task_ObtenerRoles"><dc:Bounds x="580" y="310" width="110" height="70" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_EmitirJWT_di" bpmnElement="Task_EmitirJWT"><dc:Bounds x="730" y="310" width="110" height="70" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Dashboard_di" bpmnElement="Task_Dashboard"><dc:Bounds x="880" y="140" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_05_Ok_di" bpmnElement="End_05_Ok"><dc:Bounds x="1042" y="162" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F_05_1_di" bpmnElement="F_05_1"><di:waypoint x="268" y="180" /><di:waypoint x="310" y="180" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_05_2_di" bpmnElement="F_05_2"><di:waypoint x="370" y="220" /><di:waypoint x="370" y="350" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_05_3_di" bpmnElement="F_05_3"><di:waypoint x="430" y="390" /><di:waypoint x="485" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_05_No_di" bpmnElement="F_05_No"><di:waypoint x="510" y="415" /><di:waypoint x="510" y="445" /><di:waypoint x="580" y="445" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_05_Si_di" bpmnElement="F_05_Si"><di:waypoint x="510" y="365" /><di:waypoint x="510" y="345" /><di:waypoint x="580" y="345" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_05_4_di" bpmnElement="F_05_4"><di:waypoint x="690" y="445" /><di:waypoint x="732" y="445" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_05_5_di" bpmnElement="F_05_5"><di:waypoint x="690" y="345" /><di:waypoint x="730" y="345" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_05_6_di" bpmnElement="F_05_6"><di:waypoint x="840" y="345" /><di:waypoint x="860" y="345" /><di:waypoint x="860" y="180" /><di:waypoint x="880" y="180" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_05_7_di" bpmnElement="F_05_7"><di:waypoint x="1000" y="180" /><di:waypoint x="1042" y="180" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>