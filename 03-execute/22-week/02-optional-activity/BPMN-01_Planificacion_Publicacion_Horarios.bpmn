<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_01" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.15.0">
  <bpmn:collaboration id="Collaboration_01">
    <bpmn:participant id="Participant_Scheduling" name="Sistema de Gestión de Horarios SENA" processRef="Process_Planificacion_Horarios" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Planificacion_Horarios" name="Planificación, Validación y Publicación de Horarios" isExecutable="true">
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Coordinador" name="Coordinador Académico">
        <bpmn:flowNodeRef>StartEvent_Planeacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeleccionarFicha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AsignarFranjas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolverConflictos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmarPublicar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema de Gestión (Scheduling / Rules Engine)">
        <bpmn:flowNodeRef>Task_ValidarReglas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HayConflictos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuardarOficial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Publicado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Planeacion" name="Inicio de Planeación de Trimestre">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SeleccionarFicha" name="Seleccionar Ficha y Programa de Formación">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AsignarFranjas" name="Asignar Franjas, Instructor y Ambiente">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:incoming>Flow_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidarReglas" name="Validar Reglas de Negocio y Disponibilidad">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_HayConflictos" name="¿Se detectaron conflictos?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_ConConflicto</bpmn:outgoing>
      <bpmn:outgoing>Flow_SinConflicto</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ResolverConflictos" name="Resolver Conflictos y Reasignar Recursos">
      <bpmn:incoming>Flow_ConConflicto</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ConfirmarPublicar" name="Previsualizar y Confirmar Publicación">
      <bpmn:incoming>Flow_SinConflicto</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GuardarOficial" name="Registrar Versión Inmutable y Estado Oficial">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Notificar" name="Notificar Horarios a Instructores y Aprendices">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Publicado" name="Horario Oficial Publicado en Vigencia">
      <bpmn:incoming>Flow_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Planeacion" targetRef="Task_SeleccionarFicha" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SeleccionarFicha" targetRef="Task_AsignarFranjas" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_AsignarFranjas" targetRef="Task_ValidarReglas" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ValidarReglas" targetRef="Gateway_HayConflictos" />
    <bpmn:sequenceFlow id="Flow_ConConflicto" name="Sí" sourceRef="Gateway_HayConflictos" targetRef="Task_ResolverConflictos" />
    <bpmn:sequenceFlow id="Flow_SinConflicto" name="No" sourceRef="Gateway_HayConflictos" targetRef="Task_ConfirmarPublicar" />
    <bpmn:sequenceFlow id="Flow_Retry" sourceRef="Task_ResolverConflictos" targetRef="Task_AsignarFranjas" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ConfirmarPublicar" targetRef="Task_GuardarOficial" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_GuardarOficial" targetRef="Task_Notificar" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Notificar" targetRef="EndEvent_Publicado" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_01">
      <bpmndi:BPMNShape id="Participant_Scheduling_di" bpmnElement="Participant_Scheduling" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1120" height="490" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Coordinador_di" bpmnElement="Lane_Coordinador" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1090" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_di" bpmnElement="Lane_Sistema" isHorizontal="true">
        <dc:Bounds x="190" y="320" width="1090" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Planeacion_di" bpmnElement="StartEvent_Planeacion">
        <dc:Bounds x="232" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="210" y="215" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SeleccionarFicha_di" bpmnElement="Task_SeleccionarFicha">
        <dc:Bounds x="310" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AsignarFranjas_di" bpmnElement="Task_AsignarFranjas">
        <dc:Bounds x="460" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidarReglas_di" bpmnElement="Task_ValidarReglas">
        <dc:Bounds x="460" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HayConflictos_di" bpmnElement="Gateway_HayConflictos" isMarkerVisible="true">
        <dc:Bounds x="645" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="633" y="475" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResolverConflictos_di" bpmnElement="Task_ResolverConflictos">
        <dc:Bounds x="610" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmarPublicar_di" bpmnElement="Task_ConfirmarPublicar">
        <dc:Bounds x="780" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GuardarOficial_di" bpmnElement="Task_GuardarOficial">
        <dc:Bounds x="780" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notificar_di" bpmnElement="Task_Notificar">
        <dc:Bounds x="950" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Publicado_di" bpmnElement="EndEvent_Publicado">
        <dc:Bounds x="1122" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1102" y="465" width="77" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="268" y="190" />
        <di:waypoint x="310" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="430" y="190" />
        <di:waypoint x="460" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="520" y="230" />
        <di:waypoint x="520" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="580" y="440" />
        <di:waypoint x="645" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ConConflicto_di" bpmnElement="Flow_ConConflicto">
        <di:waypoint x="670" y="415" />
        <di:waypoint x="670" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="679" y="333" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Retry_di" bpmnElement="Flow_Retry">
        <di:waypoint x="610" y="190" />
        <di:waypoint x="580" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SinConflicto_di" bpmnElement="Flow_SinConflicto">
        <di:waypoint x="695" y="440" />
        <di:waypoint x="740" y="440" />
        <di:waypoint x="740" y="190" />
        <di:waypoint x="780" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="748" y="323" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="840" y="230" />
        <di:waypoint x="840" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="900" y="440" />
        <di:waypoint x="950" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="1070" y="440" />
        <di:waypoint x="1122" y="440" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
