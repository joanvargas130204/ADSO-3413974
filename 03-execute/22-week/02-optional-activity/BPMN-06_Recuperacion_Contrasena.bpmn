<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_06" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.15.0">
  <bpmn:collaboration id="Collab_06">
    <bpmn:participant id="Part_Reset" name="Recuperación y Restablecimiento de Contraseña" processRef="Proc_Reset" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Reset" name="Recuperación de Contraseña" isExecutable="true">
    <bpmn:laneSet id="LaneSet_06">
      <bpmn:lane id="Lane_User_06" name="Usuario">
        <bpmn:flowNodeRef>Start_06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NuevaClave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_06_Ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IAM_06" name="Servicio IAM &amp; Notificaciones">
        <bpmn:flowNodeRef>Task_ValEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_06_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenToken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActualizarClave</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_06" name="Usuario Olvidó Contraseña"><bpmn:outgoing>F_06_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_Email" name="Ingresar Correo Institucional"><bpmn:incoming>F_06_1</bpmn:incoming><bpmn:outgoing>F_06_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_ValEmail" name="Verificar Registro y Estado"><bpmn:incoming>F_06_2</bpmn:incoming><bpmn:outgoing>F_06_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_Email" name="¿Cuenta Activa?"><bpmn:incoming>F_06_3</bpmn:incoming><bpmn:outgoing>F_06_No</bpmn:outgoing><bpmn:outgoing>F_06_Si</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_06_Fail" name="Fin (Respuesta Genérica de Seguridad)"><bpmn:incoming>F_06_No</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_GenToken" name="Generar Token Temporal (15m)"><bpmn:incoming>F_06_Si</bpmn:incoming><bpmn:outgoing>F_06_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendMail" name="Enviar Enlace Mágico por Correo"><bpmn:incoming>F_06_4</bpmn:incoming><bpmn:outgoing>F_06_5</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="Task_NuevaClave" name="Ingresar Nueva Contraseña Segura"><bpmn:incoming>F_06_5</bpmn:incoming><bpmn:outgoing>F_06_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_ActualizarClave" name="Validar Políticas, Hashear y Revocar Sesiones Anteriores"><bpmn:incoming>F_06_6</bpmn:incoming><bpmn:outgoing>F_06_7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="End_06_Ok" name="Contraseña Actualizada"><bpmn:incoming>F_06_7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_06_1" sourceRef="Start_06" targetRef="Task_Email" />
    <bpmn:sequenceFlow id="F_06_2" sourceRef="Task_Email" targetRef="Task_ValEmail" />
    <bpmn:sequenceFlow id="F_06_3" sourceRef="Task_ValEmail" targetRef="Gate_Email" />
    <bpmn:sequenceFlow id="F_06_No" name="No" sourceRef="Gate_Email" targetRef="End_06_Fail" />
    <bpmn:sequenceFlow id="F_06_Si" name="Sí" sourceRef="Gate_Email" targetRef="Task_GenToken" />
    <bpmn:sequenceFlow id="F_06_4" sourceRef="Task_GenToken" targetRef="Task_SendMail" />
    <bpmn:sequenceFlow id="F_06_5" sourceRef="Task_SendMail" targetRef="Task_NuevaClave" />
    <bpmn:sequenceFlow id="F_06_6" sourceRef="Task_NuevaClave" targetRef="Task_ActualizarClave" />
    <bpmn:sequenceFlow id="F_06_7" sourceRef="Task_ActualizarClave" targetRef="End_06_Ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_06"><bpmndi:BPMNPlane id="Plane_06" bpmnElement="Collab_06">
    <bpmndi:BPMNShape id="Part_Reset_di" bpmnElement="Part_Reset" isHorizontal="true"><dc:Bounds x="160" y="80" width="1050" height="420" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_User_06_di" bpmnElement="Lane_User_06" isHorizontal="true"><dc:Bounds x="190" y="80" width="1020" height="210" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_IAM_06_di" bpmnElement="Lane_IAM_06" isHorizontal="true"><dc:Bounds x="190" y="290" width="1020" height="210" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_06_di" bpmnElement="Start_06"><dc:Bounds x="232" y="162" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Email_di" bpmnElement="Task_Email"><dc:Bounds x="310" y="140" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ValEmail_di" bpmnElement="Task_ValEmail"><dc:Bounds x="310" y="350" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Gate_Email_di" bpmnElement="Gate_Email" isMarkerVisible="true"><dc:Bounds x="475" y="365" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_06_Fail_di" bpmnElement="End_06_Fail"><dc:Bounds x="482" y="442" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_GenToken_di" bpmnElement="Task_GenToken"><dc:Bounds x="560" y="350" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_SendMail_di" bpmnElement="Task_SendMail"><dc:Bounds x="700" y="350" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_NuevaClave_di" bpmnElement="Task_NuevaClave"><dc:Bounds x="700" y="140" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ActualizarClave_di" bpmnElement="Task_ActualizarClave"><dc:Bounds x="850" y="350" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_06_Ok_di" bpmnElement="End_06_Ok"><dc:Bounds x="1032" y="162" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F_06_1_di" bpmnElement="F_06_1"><di:waypoint x="268" y="180" /><di:waypoint x="310" y="180" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_06_2_di" bpmnElement="F_06_2"><di:waypoint x="370" y="220" /><di:waypoint x="370" y="350" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_06_3_di" bpmnElement="F_06_3"><di:waypoint x="430" y="390" /><di:waypoint x="475" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_06_No_di" bpmnElement="F_06_No"><di:waypoint x="500" y="415" /><di:waypoint x="500" y="442" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_06_Si_di" bpmnElement="F_06_Si"><di:waypoint x="525" y="390" /><di:waypoint x="560" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_06_4_di" bpmnElement="F_06_4"><di:waypoint x="670" y="390" /><di:waypoint x="700" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_06_5_di" bpmnElement="F_06_5"><di:waypoint x="755" y="350" /><di:waypoint x="755" y="220" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_06_6_di" bpmnElement="F_06_6"><di:waypoint x="810" y="180" /><di:waypoint x="830" y="180" /><di:waypoint x="830" y="390" /><di:waypoint x="850" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F_06_7_di" bpmnElement="F_06_7"><di:waypoint x="980" y="390" /><di:waypoint x="1006" y="390" /><di:waypoint x="1006" y="180" /><di:waypoint x="1032" y="180" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>