// Diagrama de casos de uso UML - CoffeeCol / Tantico Café (fuente editable)
// Render: dot -Tpng -Gdpi=100 casos-de-uso.dot -o casos-de-uso.png ; dot -Tsvg casos-de-uso.dot -o casos-de-uso.svg
digraph CU {
  rankdir=LR; splines=true; nodesep=0.3; ranksep=1.0; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];
  node [shape=none, image="actor.png", imagescale=false, labelloc=b, width=1.0, height=1.3];
  VIS [label="Visitante"]; CLI [label="Cliente registrado"]; ADM [label="Administrador"];
  FIR [label="Firebase Authentication\n«actor secundario»"]; TMP [label="Temporizador del sistema\n«inicia proceso automático»"];
  subgraph cluster_sys { label="Sistema CoffeeCol / Tantico Café (frontera del sistema)"; labeljust=l; fontsize=14; style=rounded; color="#555555"; bgcolor="#fbfbf7";
    node [shape=ellipse, image="", style=filled, fillcolor="#ffffff", width=2.3, height=0.55, labelloc=c];
    CU01 [label="CU-01 Ver mapa del Huila"];
    CU02 [label="CU-02 Explorar catálogo"];
    CU03 [label="CU-03 Iniciar sesión con Firebase"];
    CU04 [label="CU-04 Enviar contacto"];
    CU05 [label="CU-05 Gestionar carrito"];
    CU06 [label="CU-06 Realizar checkout y generar pedido"];
    CU07 [label="CU-07 Administrar perfil y direcciones"];
    CU08 [label="CU-08 Gestionar favoritos"];
    CU09 [label="CU-09 Consultar puntos y nivel"];
    CU10 [label="CU-10 Iniciar sesión de administrador"];
    CU11 [label="CU-11 Gestionar productos"];
    CU12 [label="CU-12 Gestionar pedidos"];
    CU13 [label="CU-13 Auditar directorio de clientes"];
    CU14 [label="CU-14 Consultar KPIs y analítica"];
    CU15 [label="CU-15 Consultar información de la marca"];
    CU16 [label="CU-16 Ver detalle de producto"];
    CU17 [label="CU-17 Sincronizar usuario"];
    CU18 [label="CU-18 Cerrar sesión"];
    CU19 [label="CU-19 Validar datos de entrega"];
    CU20 [label="CU-20 Acumular puntos por compra"];
    CU21 [label="CU-21 Consultar historial de pedidos"];
    CU22 [label="CU-22 Canjear recompensa"];
    CU23 [label="CU-23 Acreditar bono de cumpleaños"];
    CU24 [label="CU-24 Controlar intentos de acceso"];
    CU25 [label="CU-25 Cargar imagen de producto"];
    CU26 [label="CU-26 Validar archivo de imagen"];
    CU27 [label="CU-27 Exportar reporte"];
  }
  CLI -> VIS [arrowhead=empty, label="generalización"];
  edge [arrowhead=none];
  VIS -> CU01;
  VIS -> CU02;
  VIS -> CU03;
  VIS -> CU04;
  VIS -> CU05;
  VIS -> CU15;
  CLI -> CU06;
  CLI -> CU07;
  CLI -> CU08;
  CLI -> CU09;
  CLI -> CU18;
  CLI -> CU21;
  CLI -> CU22;
  ADM -> CU10;
  ADM -> CU11;
  ADM -> CU12;
  ADM -> CU13;
  ADM -> CU14;
  ADM -> CU18;
  TMP -> CU23;
  CU03 -> FIR;
  edge [style=dashed, arrowhead=open];
  CU03 -> CU17 [label="«include»"];
  CU06 -> CU19 [label="«include»"];
  CU06 -> CU20 [label="«include»"];
  CU10 -> CU24 [label="«include»"];
  CU25 -> CU26 [label="«include»"];
  CU16 -> CU02 [label="«extend»"];
  CU22 -> CU09 [label="«extend»"];
  CU25 -> CU11 [label="«extend»"];
  CU27 -> CU14 [label="«extend»"];
}
